{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AtCoder: CPythonでデバッグ",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_problem.py",
      "args": [
        "${workspaceFolder}/${input:problem}/Main.py"
      ],
      "cwd": "${workspaceFolder}/${input:problem}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "env": {
        "ATCODER_INPUT_FILE": "${workspaceFolder}/${input:problem}/samples/${input:sample}.in"
      }
    },
    {
      "name": "AtCoder: PyPyでデバッグ",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_problem.py",
      "args": [
        "${workspaceFolder}/${input:problem}/Main.py"
      ],
      "cwd": "${workspaceFolder}/${input:problem}",
      "python": "${workspaceFolder}/.venv-pypy/Scripts/python.exe",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "env": {
        "ATCODER_INPUT_FILE": "${workspaceFolder}/${input:problem}/samples/${input:sample}.in"
      }
    }
  ],
  "inputs": [
    {
      "id": "problem",
      "type": "promptString",
      "description": "対象問題ディレクトリ",
      "default": "problems/ABC468/abc468-a"
    },
    {
      "id": "sample",
      "type": "promptString",
      "description": "サンプル番号",
      "default": "01"
    }
  ]
}
