{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AtCoder: 初回準備",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\setup.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "AtCoder: Ruffチェック",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        "."
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "AtCoder: サンプルテスト",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\test-samples.ps1",
        "${input:problem}"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "problem",
      "type": "promptString",
      "description": "対象問題ディレクトリ",
      "default": "problems/ABC468/abc468-a"
    }
  ]
}
