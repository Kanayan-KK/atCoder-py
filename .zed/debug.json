[
  {
    "label": "AtCoder: PyPyでデバッグ",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/scripts/debug_problem.py",
    "args": [
      "--interactive",
      "${ZED_FILE:}"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "python": "$ZED_WORKTREE_ROOT/.venv-pypy/Scripts/python.exe",
    "console": "integratedTerminal",
    "stopOnEntry": false,
    "env": {
      "PYTHONIOENCODING": "cp932"
    }
  },
  {
    "label": "AtCoder: CPythonでデバッグ",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/scripts/debug_problem.py",
    "args": [
      "--interactive",
      "${ZED_FILE:}"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "python": "$ZED_WORKTREE_ROOT/.venv/Scripts/python.exe",
    "console": "integratedTerminal",
    "stopOnEntry": false,
    "env": {
      "PYTHONIOENCODING": "cp932"
    }
  }
]
